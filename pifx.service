[Unit]
Description=pifx - PCM5122 HAT effects box with web UI and Launchpad control
After=sound.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__DIR__
ExecStart=/usr/bin/python3 -m pifx serve --host 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1
# low-latency audio: let PortAudio raise the callback thread priority
LimitRTPRIO=95
LimitMEMLOCK=infinity
Nice=-10

[Install]
WantedBy=multi-user.target
