{
  "version": 3,
  "cmakeMinimumRequired": {"major": 3, "minor": 20, "patch": 0},
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Release (Pi: tuned for this CPU)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Release", "PIFX_NATIVE": "ON"}
    },
    {
      "name": "debug",
      "displayName": "Debug (gdb, VS Code)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-debug",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug"}
    },
    {
      "name": "asan",
      "displayName": "Debug + AddressSanitizer",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build-asan",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "headless",
      "displayName": "No GUI (engine, CLI, tests only)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-headless",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Release", "PIFX_GUI": "OFF"}
    }
  ],
  "buildPresets": [
    {"name": "release", "configurePreset": "release"},
    {"name": "debug", "configurePreset": "debug"},
    {"name": "asan", "configurePreset": "asan"},
    {"name": "headless", "configurePreset": "headless"}
  ],
  "testPresets": [
    {"name": "debug", "configurePreset": "debug", "output": {"outputOnFailure": true}},
    {"name": "release", "configurePreset": "release", "output": {"outputOnFailure": true}}
  ]
}
