# Turns the two TTF files into C arrays: cmake -DOUT=x.cpp -DSANS=a.ttf -DMONO=b.ttf -P embed_fonts.cmake
function(embed var path out)
  file(READ ${path} hex HEX)
  string(LENGTH "${hex}" n)
  math(EXPR bytes "${n} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
  string(REGEX REPLACE "(0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,)" "\\1\n" hex "${hex}")
  file(APPEND ${out} "extern const unsigned char ${var}[] = {\n${hex}\n};\nextern const unsigned int ${var}_size = ${bytes};\n")
endfunction()
file(WRITE ${OUT} "// generated by cmake/embed_fonts.cmake - do not edit\n")
embed(pifx_font_sans ${SANS} ${OUT})
embed(pifx_font_mono ${MONO} ${OUT})
