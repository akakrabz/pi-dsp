{
  // Copy this folder to .vscode/ (install.sh does it). F5 builds the debug preset and
  // starts pifx under gdb (extension: ms-vscode.cpptools).
  // Works locally on the Pi or through VS Code Remote-SSH from the laptop.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "pifx (GUI)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build-debug/pifx",
      "args": [],
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "setupCommands": [{"text": "-enable-pretty-printing", "ignoreFailures": true}],
      "preLaunchTask": "build debug"
    },
    {
      "name": "pifx headless (no window)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build-debug/pifx",
      "args": ["headless"],
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "setupCommands": [{"text": "-enable-pretty-printing", "ignoreFailures": true}],
      "preLaunchTask": "build debug"
    },
    {
      "name": "unit tests",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build-debug/pifx_tests",
      "args": [],
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "setupCommands": [{"text": "-enable-pretty-printing", "ignoreFailures": true}],
      "preLaunchTask": "build debug"
    }
  ]
}
